{
  "name": "@panoptic-eng/docs",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "docusaurus": "docusaurus",
    "generate:recent": "node generateRecentUpdates.js",
    "prestart": "pnpm generate:recent",
    "start": "docusaurus start",
    "prebuild": "pnpm generate:recent && pnpm check:risk-tables",
    "build": "docusaurus build",
    "graphql-markdown": "node ./scripts/gen-subgraph-docs.js",
    "test:subgraph": "node ./scripts/check-subgraph-docs.js",
    "lint:subgraph": "prettier --check scripts/gen-subgraph-docs.js scripts/check-subgraph-docs.js",
    "format:subgraph": "prettier --write scripts/gen-subgraph-docs.js scripts/check-subgraph-docs.js",
    "swizzle": "docusaurus swizzle",
    "deploy": "docusaurus deploy",
    "clear": "docusaurus clear",
    "serve": "docusaurus serve",
    "write-translations": "docusaurus write-translations",
    "write-heading-ids": "docusaurus write-heading-ids",
    "refresh:risk-engines": "node scripts/refresh-risk-engines.mjs && pnpm format:risk-data && pnpm generate:risk-tables",
    "generate:risk-tables": "node scripts/generate-risk-tables.mjs",
    "check:risk-tables": "node scripts/generate-risk-tables.mjs --check",
    "test": "node --test scripts/*.test.mjs && pnpm check:risk-tables && pnpm test:examples",
    "lint": "prettier --check \"scripts/*.mjs\" \"plugins/*.cjs\" \"static/data/risk-engines.json\" && pnpm lint:examples && pnpm lint:seo",
    "format:risk-data": "prettier --write \"scripts/*.mjs\" \"plugins/*.cjs\" \"static/data/risk-engines.json\"",
    "generate:contracts": "node scripts/generate-contracts.mjs",
    "postbuild": "pnpm export:markdown && node scripts/verify-build.mjs && pnpm verify:entities",
    "export:markdown": "node scripts/export-markdown.mjs",
    "lint:examples": "prettier --check --no-semi --single-quote \"static/examples/trade-lifecycle/*.mjs\" \"static/examples/trade-lifecycle/package.json\"",
    "format:examples": "prettier --write --no-semi --single-quote \"static/examples/trade-lifecycle/*.mjs\" \"static/examples/trade-lifecycle/package.json\"",
    "test:examples": "node --test static/examples/trade-lifecycle/*.test.mjs",
    "verify:entities": "node scripts/verify-entity-schema.mjs",
    "lint:seo": "prettier --check src/data/entities.cjs src/components/StructuredData.js src/pages/about.js src/pages/about.module.css src/theme/BlogPostPage/Metadata/index.js blog/authors.yml research/authors.yml",
    "format:seo": "prettier --write src/data/entities.cjs src/components/StructuredData.js src/pages/about.js src/pages/about.module.css src/theme/BlogPostPage/Metadata/index.js blog/authors.yml research/authors.yml"
  },
  "dependencies": {
    "@docsearch/react": "3.9.0",
    "@docusaurus/core": "2.4.3",
    "@docusaurus/plugin-client-redirects": "2.4.3",
    "@docusaurus/plugin-content-blog": "2.4.3",
    "@docusaurus/preset-classic": "2.4.3",
    "@docusaurus/theme-common": "2.4.3",
    "@docusaurus/theme-search-algolia": "2.4.3",
    "@docusaurus/utils-common": "2.4.3",
    "@fontsource-variable/dm-sans": "^5.2.8",
    "@fontsource-variable/space-grotesk": "^5.2.10",
    "@fontsource/fragment-mono": "^5.2.8",
    "@fontsource/jetbrains-mono": "^5.2.8",
    "@headlessui/react": "1.7.17",
    "@mdx-js/react": "^1.6.22",
    "@radix-ui/react-accordion": "^1.1.2",
    "@radix-ui/react-dialog": "^1.0.4",
    "@radix-ui/react-popover": "^1.0.6",
    "@radix-ui/react-select": "^1.2.2",
    "@radix-ui/react-tabs": "^1.0.4",
    "autoprefixer": "^10.4.16",
    "classnames": "2.5.1",
    "clsx": "^1.2.1",
    "framer-motion": "^12.38.0",
    "gray-matter": "4.0.3",
    "hast-util-is-element": "1.1.0",
    "inter-ui": "^3.19.3",
    "postcss": "^8.4.31",
    "prism-react-renderer": "^1.3.5",
    "react": "^18.2.0",
    "react-confetti-explosion": "^2.1.2",
    "react-countup": "^6.5.3",
    "react-dom": "^18.2.0",
    "react-hubspot-form": "^1.3.7",
    "react-intersection-observer": "^10.0.3",
    "react-markdown": "^8.0.7",
    "react-router-dom": "5.3.4",
    "react-sanfona": "1.5.0",
    "react-slick": "^0.29.0",
    "react-use-draggable-scroll": "^0.4.7",
    "recharts": "^2.7.2",
    "rehype-katex": "^5.0.0",
    "remark-math": "^3.0.1",
    "slick-carousel": "^1.8.1",
    "tailwindcss": "^3.3.3",
    "typeface-open-sans": "^1.1.13",
    "typeface-quicksand": "^1.1.13"
  },
  "devDependencies": {
    "@docusaurus/module-type-aliases": "2.4.1",
    "cheerio": "1.2.0",
    "graphql": "^16.0.0",
    "graphql-markdown": "^7.0.0",
    "prettier": "3.7.3",
    "sharp": "0.34.5",
    "turndown": "7.2.2",
    "turndown-plugin-gfm": "1.0.2",
    "viem": "2.41.2",
    "webpack": "5.103.0"
  },
  "browserslist": {
    "production": [
      ">0.5%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "engines": {
    "node": ">=20.19.0 <23.0.0"
  },
  "packageManager": "pnpm@10.29.2+sha512.bef43fa759d91fd2da4b319a5a0d13ef7a45bb985a3d7342058470f9d2051a3ba8674e629672654686ef9443ad13a82da2beb9eeb3e0221c87b8154fff9d74b8"
}
